# ============================================================
# ENVIRONMENT & SECRETS — never commit these
# ============================================================
.env
.env.local
.env.*.local
.env.development
.env.production
oracle/.env

# ============================================================
# NODE MODULES — all packages
# ============================================================
node_modules/
frontend/node_modules/
oracle/node_modules/

# ============================================================
# FRONTEND BUILD OUTPUTS
# ============================================================
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/coverage/

# ============================================================
# NOIR / CIRCUIT ARTIFACTS
# ============================================================
# Compiled ACIR bytecode and witness outputs
circuit/target/
circuit/proofs/
# Prover artifacts (contain private witness data)
circuit/Prover.toml.bak

# ============================================================
# FOUNDRY / CONTRACTS BUILD ARTIFACTS
# ============================================================
contracts/out/
contracts/cache/
contracts/broadcast/
# Deployment receipts (contain tx hashes, fine to commit selectively)
# Uncomment below if you want to track deployment records:
# !contracts/broadcast/Deploy.s.sol/

# ============================================================
# BARRETENBERG / BB ARTIFACTS
# ============================================================
# Local bb proving artifacts
*.proof
*.vk
*.pk
bb_artifacts/

# ============================================================
# ORACLE BUILD OUTPUTS
# ============================================================
oracle/dist/
oracle/coverage/

# ============================================================
# TYPESCRIPT BUILD ARTIFACTS
# ============================================================
*.tsbuildinfo
tsconfig.tsbuildinfo
frontend/tsconfig.tsbuildinfo
oracle/tsconfig.tsbuildinfo

# ============================================================
# PNPM
# ============================================================
# Keep pnpm-lock.yaml tracked — it ensures reproducible installs
# .pnpm-store is on disk, not in repo
.pnpm-store/

# ============================================================
# LOGS
# ============================================================
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
logs/
oracle/logs/

# ============================================================
# OS & EDITOR ARTIFACTS
# ============================================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows / WSL
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# VSCode / Cursor
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json
# Keep recommended extensions file if present:
# !.vscode/extensions.json

# JetBrains
.idea/
*.iml
*.iws

# Vim / Neovim
*.swp
*.swo
*~
.netrwhist

# ============================================================
# VERCEL
# ============================================================
.vercel/

# ============================================================
# TESTING
# ============================================================
coverage/
.nyc_output/
frontend/coverage/
oracle/coverage/

# ============================================================
# MISC
# ============================================================
# Temporary / scratch notes (local only)
temp.md
*.tmp
*.temp
*.bak
*.orig

# Benchmark output artifacts
scripts/benchmark-results.json

# IMT snapshot is generated by oracle — track it for seeding
# but allow it to be overwritten by CI
# DO NOT gitignore frontend/data/imt-snapshot.json
# It must be committed so Vercel has it at build time

# Package manager lock files from other managers
# (we use pnpm exclusively)
yarn.lock
package-lock.json

frontend/.env.local
.vercel
.env*
