# Copy this file to .env and fill in real values
# Never commit .env to git

# Deployer wallet private key (without 0x prefix)
DEPLOYER_PRIVATE_KEY=your_private_key_here

# Oracle wallet address (authorised to call updateRoot on SanctionsList)
ORACLE_ADDRESS=0x0000000000000000000000000000000000000000

# Address of the deployed Verifier contract (deploy via bb contract first)
VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000

# RPC endpoints
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_key
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_alchemy_key

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here
