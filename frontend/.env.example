# Frontend environment (copy to .env.local for local dev)
#
# PRODUCTION: these MUST also be set in the Vercel dashboard
# (Project → Settings → Environment Variables → Production).
# GitHub Actions secrets do NOT inject VITE_* into the frontend build —
# only Vercel project env vars are baked in at `vercel build` time.

VITE_COMPLIANCE_GATE_ADDRESS=0x1906B284ef0DA8Dc41b531bb08E2Ae9eEAAeEA5f
VITE_SANCTIONS_LIST_ADDRESS=0xc4981582b3Fd662F825BcAA943F06F3E91cBb628
VITE_VERIFIER_ADDRESS=0x858993CbAF3F0e7a53e8a3d913cf38C1C7a2Bbc7
VITE_SUBMISSION_ROUTER_ADDRESS=0x094AC492023157c9e2F228e3620e31C249cd3035
VITE_COMPLIANT_VAULT_ADDRESS=0x651304b0a0883C882Aa2a9a24E5AAC911AFc829f
VITE_SEPOLIA_RPC_URL=

# Relayer API (Render production URL)
VITE_ORACLE_BASE_URL=https://nullproof-relayer.onrender.com
VITE_USE_RELAYER=true
VITE_ALLOW_DIRECT_SUBMIT=true

VITE_WALLETCONNECT_PROJECT_ID=
