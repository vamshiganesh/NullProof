[
  {
    "type": "constructor",
    "inputs": [
      { "name": "initialOwner",   "type": "address", "internalType": "address" },
      { "name": "initialUpdater", "type": "address", "internalType": "address" }
    ],
    "stateMutability": "nonpayable"
  },

  {
    "type": "function",
    "name": "updateRoot",
    "inputs": [
      { "name": "newRoot",      "type": "bytes32", "internalType": "bytes32" },
      { "name": "addressCount", "type": "uint256", "internalType": "uint256" }
    ],
    "outputs": [],
    "stateMutability": "nonpayable"
  },

  {
    "type": "function",
    "name": "currentRoot",
    "inputs": [],
    "outputs": [
      { "name": "", "type": "bytes32", "internalType": "bytes32" }
    ],
    "stateMutability": "view"
  },

  {
    "type": "function",
    "name": "lastUpdatedAt",
    "inputs": [],
    "outputs": [
      { "name": "", "type": "uint256", "internalType": "uint256" }
    ],
    "stateMutability": "view"
  },

  {
    "type": "function",
    "name": "currentAddressCount",
    "inputs": [],
    "outputs": [
      { "name": "", "type": "uint256", "internalType": "uint256" }
    ],
    "stateMutability": "view"
  },

  {
    "type": "function",
    "name": "getRootHistory",
    "inputs": [
      { "name": "root", "type": "bytes32", "internalType": "bytes32" }
    ],
    "outputs": [
      { "name": "addressCount", "type": "uint256", "internalType": "uint256" },
      { "name": "timestamp",    "type": "uint256", "internalType": "uint256" },
      { "name": "exists",       "type": "bool",    "internalType": "bool"    }
    ],
    "stateMutability": "view"
  },

  {
    "type": "function",
    "name": "isKnownRoot",
    "inputs": [
      { "name": "root", "type": "bytes32", "internalType": "bytes32" }
    ],
    "outputs": [
      { "name": "", "type": "bool", "internalType": "bool" }
    ],
    "stateMutability": "view"
  },

  {
    "type": "function",
    "name": "isAuthorisedUpdater",
    "inputs": [
      { "name": "account", "type": "address", "internalType": "address" }
    ],
    "outputs": [
      { "name": "", "type": "bool", "internalType": "bool" }
    ],
    "stateMutability": "view"
  },

  {
    "type": "function",
    "name": "getRecentRoots",
    "inputs": [
      { "name": "n", "type": "uint256", "internalType": "uint256" }
    ],
    "outputs": [
      { "name": "roots",      "type": "bytes32[]", "internalType": "bytes32[]" },
      { "name": "timestamps", "type": "uint256[]", "internalType": "uint256[]" }
    ],
    "stateMutability": "view"
  },

  {
    "type": "function",
    "name": "authoriseUpdater",
    "inputs": [
      { "name": "updater", "type": "address", "internalType": "address" }
    ],
    "outputs": [],
    "stateMutability": "nonpayable"
  },

  {
    "type": "function",
    "name": "revokeUpdater",
    "inputs": [
      { "name": "updater", "type": "address", "internalType": "address" }
    ],
    "outputs": [],
    "stateMutability": "nonpayable"
  },

  {
    "type": "function",
    "name": "owner",
    "inputs": [],
    "outputs": [
      { "name": "", "type": "address", "internalType": "address" }
    ],
    "stateMutability": "view"
  },

  {
    "type": "function",
    "name": "renounceOwnership",
    "inputs": [],
    "outputs": [],
    "stateMutability": "nonpayable"
  },

  {
    "type": "function",
    "name": "transferOwnership",
    "inputs": [
      { "name": "newOwner", "type": "address", "internalType": "address" }
    ],
    "outputs": [],
    "stateMutability": "nonpayable"
  },

  {
    "type": "event",
    "name": "RootUpdated",
    "inputs": [
      { "name": "previousRoot",  "type": "bytes32", "internalType": "bytes32", "indexed": true  },
      { "name": "newRoot",       "type": "bytes32", "internalType": "bytes32", "indexed": true  },
      { "name": "addressCount",  "type": "uint256", "internalType": "uint256", "indexed": false },
      { "name": "timestamp",     "type": "uint256", "internalType": "uint256", "indexed": false }
    ],
    "anonymous": false
  },

  {
    "type": "event",
    "name": "UpdaterAuthorised",
    "inputs": [
      { "name": "updater", "type": "address", "internalType": "address", "indexed": true }
    ],
    "anonymous": false
  },

  {
    "type": "event",
    "name": "UpdaterRevoked",
    "inputs": [
      { "name": "updater", "type": "address", "internalType": "address", "indexed": true }
    ],
    "anonymous": false
  },

  {
    "type": "event",
    "name": "OwnershipTransferred",
    "inputs": [
      { "name": "previousOwner", "type": "address", "internalType": "address", "indexed": true },
      { "name": "newOwner",      "type": "address", "internalType": "address", "indexed": true }
    ],
    "anonymous": false
  },

  { "type": "error", "name": "OwnableUnauthorizedAccount", "inputs": [{ "name": "account", "type": "address", "internalType": "address" }] },
  { "type": "error", "name": "OwnableInvalidOwner",        "inputs": [{ "name": "owner",   "type": "address", "internalType": "address" }] }
]
