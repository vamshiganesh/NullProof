# ============================================================
# nullproof-oracle — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# RPC
# ------------------------------------------------------------

# Sepolia JSON-RPC endpoint (Alchemy / Infura / etc.)
# Example: https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
SEPOLIA_RPC_URL=

# ------------------------------------------------------------
# Oracle wallet
# ------------------------------------------------------------

# Private key of the wallet authorised as `updater` on SanctionsList.
# Must be a 0x-prefixed 32-byte hex string.
# Fund it with ~0.05 SepoliaETH to cover gas.
ORACLE_PRIVATE_KEY=

# ------------------------------------------------------------
# Contract addresses (Sepolia)
# ------------------------------------------------------------

# Deployed SanctionsList contract address
SANCTIONS_LIST_ADDRESS=

# ------------------------------------------------------------
# OFAC feed
# ------------------------------------------------------------

# Full URL to the OFAC SDN XML feed.
# Default points to the official Treasury bulk download.
# Override only if mirroring locally or using a proxy.
OFAC_SDN_URL=https://www.treasury.gov/ofac/downloads/sdn.xml

# ------------------------------------------------------------
# Oracle behaviour
# ------------------------------------------------------------

# How often to re-publish the root (cron expression, UTC).
# Default: every day at 00:05 UTC
CRON_SCHEDULE="5 0 * * *"

# Minimum ETH addresses in the OFAC feed before publish (sanity floor).
# The SDN list has ~90 Ethereum addresses — do not set above ~85.
MIN_ADDRESS_COUNT=50

# Manifest path (relative to oracle/). Full snapshot: frontend/public/data/sanctions-imt.json
MANIFEST_PATH=../frontend/public/data/imt-manifest.json

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------

# Log level: error | warn | info | debug
LOG_LEVEL=info

# ------------------------------------------------------------
# Relayer API (private submission)
# ------------------------------------------------------------

# HTTP port for relayer API (default 3001)
PORT=3001

# Comma-separated allowed CORS origins (production: your Vercel URL)
CORS_ORIGIN=http://localhost:3000,http://localhost:3003

# Private key of the relayer wallet (broadcasts SubmissionRouter txs)
# MUST be different from ORACLE_PRIVATE_KEY in production.
RELAYER_PRIVATE_KEY=

# Deployed SubmissionRouter contract address
SUBMISSION_ROUTER_ADDRESS=

# Deployed ComplianceGate contract address
COMPLIANCE_GATE_ADDRESS=

# Sepolia chain ID
CHAIN_ID=11155111

# Require EIP-712 signature on POST /api/submit (set false after Phase 2)
REQUIRE_RELAYER_AUTH=true
