{
    "name": "nullproof",
    "version": "0.1.0",
    "private": true,
    "description": "ZK non-membership compliance layer — prove your wallet is not on the OFAC sanctions list without revealing your address",
    "author": "",
    "license": "MIT",
    "engines": {
        "node": ">=20.0.0",
        "pnpm": ">=10.0.0"
    },
    "packageManager": "pnpm@10.28.0",
    "scripts": {
        "dev": "pnpm --filter nullproof-frontend dev",
        "build": "pnpm --filter nullproof-frontend build",
        "preview": "pnpm --filter nullproof-frontend preview",
        "oracle:run": "pnpm --filter nullproof-oracle start",
        "oracle:dev": "pnpm --filter nullproof-oracle dev",
        "oracle:api": "pnpm --filter nullproof-oracle api",
        "oracle:dev:api": "pnpm --filter nullproof-oracle dev:api",
        "snapshot": "pnpm --filter nullproof-frontend snapshot",
        "verify-proof": "pnpm --filter nullproof-frontend verify-proof",
        "circuit:compile": "bash scripts/build-circuit.sh",
        "circuit:test": "cd circuit && nargo test",
        "circuit:prove": "cd circuit && nargo prove",
        "contracts:build": "cd contracts && forge build",
        "contracts:test": "cd contracts && forge test -vvv",
        "contracts:deploy:local": "cd contracts && forge script script/Deploy.s.sol --broadcast --rpc-url http://localhost:8545",
        "contracts:deploy:sepolia": "cd contracts && forge script script/Deploy.s.sol --broadcast --rpc-url $SEPOLIA_RPC_URL --verify",
        "contracts:anvil": "anvil",
        "sync:abis": "bash scripts/sync-abis.sh",
        "benchmark": "npx tsx scripts/benchmark.ts",
        "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
        "lint:fix": "eslint . --ext .ts,.tsx --fix",
        "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css}\"",
        "typecheck": "pnpm --filter nullproof-frontend typecheck && pnpm --filter nullproof-oracle typecheck",
        "clean": "rm -rf frontend/dist oracle/dist contracts/out circuits/target",
        "clean:modules": "find . -name 'node_modules' -type d -not -path '*/forge-std/*' | xargs rm -rf"
    },
    "devDependencies": {
        "@types/node": "^25.9.2",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "eslint": "^9.0.0",
        "eslint-import-resolver-typescript": "^3.6.0",
        "eslint-plugin-react": "^7.37.0",
        "eslint-plugin-react-hooks": "^5.0.0",
        "prettier": "^3.3.0",
        "tsx": "^4.7.0",
        "typescript": "^5.5.0"
    }
}